generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String       @id @default(cuid())
  username      String       @unique
  passwordHash  String
  name          String
  email         String?      @unique
  role          Role         @default(USER)
  cargoUsuario  String?
  funcionarioId String?      @unique
  funcionario   Funcionario? @relation("FuncionarioUsuario", fields: [funcionarioId], references: [id], onDelete: SetNull)
  isActive      Boolean      @default(true)
  theme         String       @default("system") // light | dark | system
  layoutPrefs   Json?
  permissions   Json?
  lastSeenAt    DateTime?
  lastLoginAt   DateTime?
  lastLogoutAt  DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sessions            Session[]
  diarias             Diaria[]                  @relation("DiariaCreatedBy")
  faltas              Falta[]                   @relation("FaltaCreatedBy")
  agendamentosCriados AgendamentoCarregamento[] @relation("AgendamentoCreatedBy")
  manutencoesCriadas  ManutencaoProgramada[]    @relation("ManutencaoCreatedBy")
  lembretes           Lembrete[]
  pushSubscriptions   PushSubscription[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  activationKeysTarget ActivationKey[]          @relation("ActivationKeyTargetUser")
  deviceAuthorizations DeviceAuthorization[]
}

enum Role {
  ADMIN
  USER
  MANAGER
}

model Session {
  id                    String                @id @default(cuid())
  userId                String?
  deviceAuthorizationId String?
  token                 String                @unique
  expiresAt             DateTime
  createdAt             DateTime              @default(now())
  user                  User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceAuthorization   DeviceAuthorization?  @relation(fields: [deviceAuthorizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceAuthorizationId])
  @@index([token])
}

model Funcionario {
  id           String            @id @default(cuid())
  nome         String
  cpf          String?           @unique
  telefone     String?
  email        String?
  cargoId      String?
  cargo        Cargo?            @relation(fields: [cargoId], references: [id])
  dataAdmissao DateTime?
  salario      Decimal?
  status       StatusFuncionario @default(ATIVO)
  observacoes  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  diarias Diaria[]
  faltas  Falta[]

  carregamentosComoMotorista Carregamento[] @relation("CarregamentoMotorista")
  carregamentosComoAjudante  Carregamento[] @relation("CarregamentoAjudante")
  usuario                    User?          @relation("FuncionarioUsuario")

  @@index([nome])
  @@index([status])
}

enum StatusFuncionario {
  ATIVO
  INATIVO
  AFASTADO
}

model Cargo {
  id        String   @id @default(cuid())
  nome      String   @unique
  descricao String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  funcionarios Funcionario[]
}

model Caminhao {
  id            String         @id @default(cuid())
  placa         String         @unique
  modelo        String?
  marca         String?
  ano           Int?
  capacidadeKg  Decimal?
  tipo          String? // truck, carreta, bitrem etc
  status        StatusCaminhao @default(LIBERADO)
  quilometragem Int?
  renavam       String?
  chassi        String?
  observacoes   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  diarias       Diaria[]
  rotas         Rota[]
  carregamentos Carregamento[]
  agendamentos  AgendamentoCarregamento[]
  manutencoes   ManutencaoProgramada[]

  @@index([placa])
  @@index([status])
}

enum StatusCaminhao {
  LIBERADO
  CARREGANDO
  CARREGADO
  EM_ROTA
  MANUTENCAO
}

model Carregamento {
  id          String             @id @default(cuid())
  caminhaoId  String
  caminhao    Caminhao           @relation(fields: [caminhaoId], references: [id])
  motoristaId String?
  motorista   Funcionario?       @relation("CarregamentoMotorista", fields: [motoristaId], references: [id])
  ajudanteId  String?
  ajudante    Funcionario?       @relation("CarregamentoAjudante", fields: [ajudanteId], references: [id])
  data        DateTime           @default(now())
  origem      String?
  destino     String?
  pesoTotal   Decimal
  status      StatusCarregamento @default(EM_ANDAMENTO)
  observacoes String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  itens CarregamentoItem[]

  @@index([data])
  @@index([status])
  @@index([caminhaoId])
  @@index([motoristaId])
  @@index([ajudanteId])
  @@index([motoristaId, data, createdAt])
  @@index([caminhaoId, data, createdAt])
  @@index([caminhaoId, status])
}

enum StatusCarregamento {
  EM_ANDAMENTO
  FINALIZADO
  EM_ROTA
  CANCELADO
  NAO_CARREGADO
}

model CarregamentoItem {
  id                   String                 @id @default(cuid())
  carregamentoId       String
  carregamento         Carregamento           @relation(fields: [carregamentoId], references: [id], onDelete: Cascade)
  quantidade           Decimal
  peso                 Decimal
  statusItem           StatusItemCarregamento @default(PENDENTE)
  entregue             Boolean                @default(false)
  observacao           String?
  ordem                Int                    @default(0)
  descricaoLivre       String?
  ordemServico         String?
  clienteNome          String?
  clienteTelefone      String?
  clienteCidade        String?
  clienteBairro        String?
  mapaUrl              String?
  mapaUrl2             String?
  notaFiscalNome       String?
  notaFiscalData       Bytes? // legado: serÃ¡ esvaziado apÃ³s migraÃ§Ã£o para o Blob
  notaFiscalPath       String?
  notaFiscalDisponivel Boolean                @default(false)

  @@index([carregamentoId, ordem])
  @@index([carregamentoId, notaFiscalDisponivel])
  @@index([carregamentoId, statusItem])

  adicionais CarregamentoAdicional[]
}

model CarregamentoAdicional {
  id        String           @id @default(cuid())
  itemId    String
  item      CarregamentoItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  descricao String
  ordem     Int              @default(0)

  @@index([itemId, ordem])
}

enum StatusItemCarregamento {
  PENDENTE
  CARREGADO
  NAO_CARREGADO
}

model Diaria {
  id            String      @id @default(cuid())
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])
  caminhaoId    String?
  caminhao      Caminhao?   @relation(fields: [caminhaoId], references: [id])
  data          DateTime
  valor         Decimal
  observacao    String?
  createdById   String
  createdBy     User        @relation("DiariaCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([data])
  @@index([funcionarioId])
}

model Falta {
  id            String      @id @default(cuid())
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])
  data          DateTime
  tipo          TipoFalta
  justificativa String?
  atestadoUrl   String? // path or URL do arquivo
  createdById   String
  createdBy     User        @relation("FaltaCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([data])
  @@index([funcionarioId])
}

enum TipoFalta {
  FALTA
  ATESTADO
  FOLGA
  LICENCA
  OUTRO
}

model Rota {
  id             String     @id @default(cuid())
  nome           String
  origem         String
  destino        String
  origemLat      Float?
  origemLng      Float?
  destinoLat     Float?
  destinoLng     Float?
  distanciaKm    Float?
  caminhaoId     String?
  caminhao       Caminhao?  @relation(fields: [caminhaoId], references: [id])
  status         StatusRota @default(PLANEJADA)
  dataProgramada String?
  observacoes    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  pontos RotaPonto[]

  @@index([status])
  @@index([dataProgramada])
}

enum StatusRota {
  PLANEJADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model RotaPonto {
  id        String  @id @default(cuid())
  rotaId    String
  rota      Rota    @relation(fields: [rotaId], references: [id], onDelete: Cascade)
  ordem     Int
  nome      String?
  lat       Float
  lng       Float
  endereco  String?
  concluido Boolean @default(false)
}

model Alerta {
  id         String     @id @default(cuid())
  tipo       String // PESO, CAMINHAO, SISTEMA
  titulo     String
  mensagem   String
  severidade Severidade @default(INFO)
  lido       Boolean    @default(false)
  referencia String? // id relacionado
  createdAt  DateTime   @default(now())

  @@index([lido])
  @@index([createdAt])
  @@index([tipo, referencia])
}

enum Severidade {
  INFO
  WARNING
  CRITICAL
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity])
  @@index([action, entity, entityId])
}

model EnderecoFavorito {
  id        String   @id @default(cuid())
  nome      String
  pasta     String   @default("Favoritos")
  query     String
  endereco  String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// ==========================================
// AGENDAMENTOS E MANUTENÃ‡Ã•ES PROGRAMADAS
// ==========================================

enum StatusAgendamentoCarregamento {
  AGENDADO
  CONCLUIDO
  CANCELADO
}

model AgendamentoCarregamento {
  id             String                        @id @default(cuid())
  userId         String
  user           User                          @relation("AgendamentoCreatedBy", fields: [userId], references: [id], onDelete: Cascade)
  caminhaoId     String
  caminhao       Caminhao                      @relation(fields: [caminhaoId], references: [id])
  peso           Decimal
  dataHora       DateTime
  origem         String
  destino        String
  status         StatusAgendamentoCarregamento @default(AGENDADO)
  alertaGeradoEm DateTime?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  @@index([status, dataHora])
  @@index([caminhaoId])
  @@index([userId])
}

enum StatusManutencaoProgramada {
  ATIVA
  CONCLUIDA
  CANCELADA
}

model ManutencaoProgramada {
  id                String                     @id @default(cuid())
  userId            String
  user              User                       @relation("ManutencaoCreatedBy", fields: [userId], references: [id], onDelete: Cascade)
  caminhaoId        String
  caminhao          Caminhao                   @relation(fields: [caminhaoId], references: [id])
  descricao         String
  dataHora          DateTime?
  quilometragemAlvo Int?
  status            StatusManutencaoProgramada @default(ATIVA)
  alertaGeradoEm    DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([status, dataHora])
  @@index([caminhaoId, quilometragemAlvo])
  @@index([userId])
}

// ==========================================
// NOTIFICAÃ‡Ã•ES PUSH
// ==========================================

// ==========================================
// LEMBRETES E DISPOSITIVOS PUSH
// ==========================================

enum StatusLembrete {
  PENDENTE
  PROCESSANDO
  ENVIADO
  CANCELADO
}

model Lembrete {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  descricao     String
  dataHora      DateTime
  status        StatusLembrete @default(PENDENTE)
  enviadoEm     DateTime?
  processandoEm DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId, status, dataHora])
  @@index([status, dataHora])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}


model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model ActivationKey {
  id                    String                @id @default(cuid())
  codeHash              String                @unique
  targetUserId          String?
  deviceAuthorizationId String?               @unique
  expiresAt             DateTime?
  usedAt                DateTime?
  createdAt             DateTime              @default(now())
  createdByUserId       String?
  closedAt              DateTime?
  closedReason          String?
  targetUser            User?                 @relation("ActivationKeyTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  deviceAuthorization   DeviceAuthorization?  @relation(fields: [deviceAuthorizationId], references: [id], onDelete: SetNull)

  @@index([targetUserId])
  @@index([expiresAt])
}

model DeviceAuthorization {
  id              String         @id @default(cuid())
  userId          String?
  publicKey       String         @unique
  createdAt       DateTime       @default(now())
  lastSeenAt      DateTime?
  revokedAt       DateTime?
  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activationKey   ActivationKey?
  sessions        Session[]

  @@index([userId])
  @@index([revokedAt])
}

model DeviceChallenge {
  id            String   @id @default(cuid())
  challengeHash String   @unique
  publicKey     String
  purpose       String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([publicKey])
  @@index([expiresAt])
  @@index([purpose])
}

model ActivationRateLimit {
  ipHash          String @id
  attempts        Int    @default(0)
  windowStartedAt Int
  blockedUntil    Int?
  updatedAt       Int

  @@index([blockedUntil])
}

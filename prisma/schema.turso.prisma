generator client {
  provider      = "prisma-client-js"
  engineType    = "client"
  output = "../src/generated/turso"
}

datasource db {
  provider = "sqlite"
  url      = "file:./turso.db"
}

model User {
  id                  String                    @id @default(cuid())
  username            String                    @unique
  passwordHash        String
  name                String
  role                Role                      @default(USER)
  isActive            Boolean                   @default(true)
  theme               String                    @default("system")
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  permissions         Json?
  lastSeenAt          DateTime?
  lastLoginAt         DateTime?
  lastLogoutAt        DateTime?
  cargoUsuario        String?
  funcionarioId       String?                   @unique
  agendamentosCriados AgendamentoCarregamento[] @relation("AgendamentoCreatedBy")
  auditLogs           AuditLog[]
  diarias             Diaria[]                  @relation("DiariaCreatedBy")
  faltas              Falta[]                   @relation("FaltaCreatedBy")
  lembretes           Lembrete[]
  manutencoesCriadas  ManutencaoProgramada[]    @relation("ManutencaoCreatedBy")
  pushSubscriptions   PushSubscription[]
  sessions            Session[]
  funcionario         Funcionario?              @relation("FuncionarioUsuario", fields: [funcionarioId], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Funcionario {
  id                         String            @id @default(cuid())
  nome                       String
  cpf                        String?           @unique
  telefone                   String?
  email                      String?
  cargoId                    String?
  dataAdmissao               DateTime?
  salario                    Decimal?
  status                     StatusFuncionario @default(ATIVO)
  observacoes                String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  carregamentosComoAjudante  Carregamento[]    @relation("CarregamentoAjudante")
  carregamentosComoMotorista Carregamento[]    @relation("CarregamentoMotorista")
  diarias                    Diaria[]
  faltas                     Falta[]
  cargo                      Cargo?            @relation(fields: [cargoId], references: [id])
  usuario                    User?             @relation("FuncionarioUsuario")

  @@index([nome])
  @@index([status])
}

model Cargo {
  id           String        @id @default(cuid())
  nome         String        @unique
  descricao    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  funcionarios Funcionario[]
}

model Caminhao {
  id            String                    @id @default(cuid())
  placa         String                    @unique
  modelo        String?
  marca         String?
  ano           Int?
  capacidadeKg  Decimal?
  tipo          String?
  status        StatusCaminhao            @default(LIBERADO)
  quilometragem Int?
  renavam       String?
  chassi        String?
  observacoes   String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  agendamentos  AgendamentoCarregamento[]
  carregamentos Carregamento[]
  diarias       Diaria[]
  manutencoes   ManutencaoProgramada[]
  rotas         Rota[]

  @@index([placa])
  @@index([status])
}

model Carregamento {
  id          String             @id @default(cuid())
  caminhaoId  String
  data        DateTime           @default(now())
  pesoTotal   Decimal
  status      StatusCarregamento @default(EM_ANDAMENTO)
  observacoes String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  destino     String?
  origem      String?
  ajudanteId  String?
  motoristaId String?
  ajudante    Funcionario?       @relation("CarregamentoAjudante", fields: [ajudanteId], references: [id])
  caminhao    Caminhao           @relation(fields: [caminhaoId], references: [id])
  motorista   Funcionario?       @relation("CarregamentoMotorista", fields: [motoristaId], references: [id])
  itens       CarregamentoItem[]

  @@index([data])
  @@index([status])
  @@index([caminhaoId])
  @@index([motoristaId])
  @@index([ajudanteId])
}

model CarregamentoItem {
  id                   String                 @id @default(cuid())
  carregamentoId       String
  quantidade           Decimal
  peso                 Decimal
  observacao           String?
  statusItem           StatusItemCarregamento @default(PENDENTE)
  ordem                Int                    @default(0)
  descricaoLivre       String?
  ordemServico         String?
  clienteNome          String?
  clienteTelefone      String?
  clienteCidade        String?
  clienteBairro        String?
  mapaUrl              String?
  notaFiscalNome       String?
  notaFiscalData       Bytes?
  notaFiscalPath       String?
  pdfExiste            Boolean                @default(false)
  notaFiscalDisponivel Boolean                @default(false)
  mapaUrl2             String?
  carregamento         Carregamento           @relation(fields: [carregamentoId], references: [id], onDelete: Cascade)

  @@index([carregamentoId, notaFiscalDisponivel])
  @@index([carregamentoId])
}

model Diaria {
  id            String      @id @default(cuid())
  funcionarioId String
  caminhaoId    String?
  data          DateTime
  valor         Decimal
  observacao    String?
  createdById   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  caminhao      Caminhao?   @relation(fields: [caminhaoId], references: [id])
  createdBy     User        @relation("DiariaCreatedBy", fields: [createdById], references: [id])
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])

  @@index([data])
  @@index([funcionarioId])
}

model Falta {
  id            String      @id @default(cuid())
  funcionarioId String
  data          DateTime
  tipo          TipoFalta
  justificativa String?
  atestadoUrl   String?
  createdById   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  createdBy     User        @relation("FaltaCreatedBy", fields: [createdById], references: [id])
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])

  @@index([data])
  @@index([funcionarioId])
}

model Rota {
  id             String      @id @default(cuid())
  nome           String
  origem         String
  destino        String
  origemLat      Float?
  origemLng      Float?
  destinoLat     Float?
  destinoLng     Float?
  distanciaKm    Float?
  caminhaoId     String?
  status         StatusRota  @default(PLANEJADA)
  observacoes    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  dataProgramada String?
  caminhao       Caminhao?   @relation(fields: [caminhaoId], references: [id])
  pontos         RotaPonto[]

  @@index([status])
  @@index([dataProgramada])
}

model RotaPonto {
  id        String  @id @default(cuid())
  rotaId    String
  ordem     Int
  nome      String?
  lat       Float
  lng       Float
  endereco  String?
  concluido Boolean @default(false)
  rota      Rota    @relation(fields: [rotaId], references: [id], onDelete: Cascade)
}

model Alerta {
  id         String     @id @default(cuid())
  tipo       String
  titulo     String
  mensagem   String
  severidade Severidade @default(INFO)
  lido       Boolean    @default(false)
  referencia String?
  createdAt  DateTime   @default(now())

  @@index([lido])
  @@index([createdAt])
  @@index([tipo, referencia])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entity])
  @@index([action, entity, entityId])
}

model EnderecoFavorito {
  id        String   @id @default(cuid())
  nome      String
  query     String
  endereco  String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pasta     String   @default("Favoritos")

  @@index([createdAt])
}

model AgendamentoCarregamento {
  id             String                        @id @default(cuid())
  userId         String
  caminhaoId     String
  peso           Decimal
  dataHora       DateTime
  origem         String
  destino        String
  status         StatusAgendamentoCarregamento @default(AGENDADO)
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  alertaGeradoEm DateTime?
  caminhao       Caminhao                      @relation(fields: [caminhaoId], references: [id])
  user           User                          @relation("AgendamentoCreatedBy", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, dataHora])
  @@index([caminhaoId])
  @@index([userId])
}

model ManutencaoProgramada {
  id                String                     @id @default(cuid())
  userId            String
  caminhaoId        String
  descricao         String
  dataHora          DateTime?
  quilometragemAlvo Int?
  status            StatusManutencaoProgramada @default(ATIVA)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  alertaGeradoEm    DateTime?
  caminhao          Caminhao                   @relation(fields: [caminhaoId], references: [id])
  user              User                       @relation("ManutencaoCreatedBy", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, dataHora])
  @@index([caminhaoId, quilometragemAlvo])
  @@index([userId])
}

model Lembrete {
  id            String         @id @default(cuid())
  userId        String
  descricao     String
  dataHora      DateTime
  status        StatusLembrete @default(PENDENTE)
  enviadoEm     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  processandoEm DateTime?
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, dataHora])
  @@index([status, dataHora])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  ADMIN
  USER
  MANAGER
}

enum StatusFuncionario {
  ATIVO
  INATIVO
  AFASTADO
}

enum StatusCaminhao {
  LIBERADO
  CARREGANDO
  CARREGADO
  EM_ROTA
  MANUTENCAO
}

enum StatusCarregamento {
  EM_ANDAMENTO
  FINALIZADO
  CANCELADO
  NAO_CARREGADO
  EM_ROTA
}

enum StatusItemCarregamento {
  PENDENTE
  CARREGADO
  NAO_CARREGADO
}

enum TipoFalta {
  FALTA
  ATESTADO
  FOLGA
  LICENCA
  OUTRO
}

enum StatusRota {
  PLANEJADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum Severidade {
  INFO
  WARNING
  CRITICAL
}

enum StatusAgendamentoCarregamento {
  AGENDADO
  CONCLUIDO
  CANCELADO
}

enum StatusManutencaoProgramada {
  ATIVA
  CONCLUIDA
  CANCELADA
}

enum StatusLembrete {
  PENDENTE
  ENVIADO
  CANCELADO
  PROCESSANDO
}
